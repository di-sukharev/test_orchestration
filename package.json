{
  "name": "taskforge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build && bun --watch src/server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "start": "bun src/server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "bun test",
    "test:e2e": "bun run build && playwright test",
    "format": "prettier --write src tests vite.config.ts playwright.config.ts tsconfig.json package.json eslint.config.js index.html README.md REVIEW.md"
  },
  "dependencies": {
    "hono": "^4.10.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.10"
  }
}
